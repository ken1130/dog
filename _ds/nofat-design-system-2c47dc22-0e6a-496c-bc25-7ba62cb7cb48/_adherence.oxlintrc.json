{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/app/**",
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/nofat/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit|Plus Jakarta Sans|Noto Sans SC))/i]",
        "message": "Font not provided by the design system. Available: Outfit, Plus Jakarta Sans, Noto Sans SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|leading|actions|align|key|ref|className|style|children)$/]",
        "message": "<AppBar> doesn't accept that prop. Declared props: title, subtitle, leading, actions, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<AppBar> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|coach|size|ring|online|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, coach, size, ring, online."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|dot|leftIcon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, size, dot, leftIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|primary|accent|success|warning|danger|info|solid)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'primary' | 'accent' | 'success' | 'warning' | 'danger' | 'info' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Badge> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|dot|key|ref|className|style|children)$/]",
        "message": "<BottomNavItem> doesn't accept that prop. Declared props: value, label, icon, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|leftIcon|rightIcon|loading|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, leftIcon, rightIcon, loading."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|outline|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent' | 'outline' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|interactive|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, interactive."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:raised|flat|sunken|tint|warm)$/]",
        "message": "<Card> variant must be one of 'raised' | 'flat' | 'sunken' | 'tint' | 'warm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:default|lg|none)$/]",
        "message": "<Card> padding must be one of 'default' | 'lg' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|round|label|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, round, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoachBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|name|time|tone|showAvatar|avatarSize|key|ref|className|style|children)$/]",
        "message": "<CoachBubble> doesn't accept that prop. Declared props: children, name, time, tone, showAvatar, avatarSize."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoachBubble'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|tint|warm|plain)$/]",
        "message": "<CoachBubble> tone must be one of 'default' | 'tint' | 'warm' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|sets|reps|rest|detail|image|mode|checked|onToggle|onOpen|key|ref|className|style|children)$/]",
        "message": "<ExerciseRow> doesn't accept that prop. Declared props: index, name, sets, reps, rest, detail, image, mode, checked, onToggle, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseRow'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:link|check)$/]",
        "message": "<ExerciseRow> mode must be one of 'link' | 'check'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|fill|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, fill."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:check|x|chevron-right|chevron-left|chevron-down|arrow-right|arrow-left|plus|minus|clock|timer|flame|zap|info|alert-triangle|user|mail|lock|eye|eye-off|home|calendar|chart|trending-up|trending-down|message-circle|send|sparkles|leaf|droplet|moon|bell|camera|image|target|trophy|heart|star|play|utensils|chef-hat|repeat|check-circle|circle|settings|more-horizontal|scale|dumbbell|apple)$/]",
        "message": "<Icon> name must be one of 'check' | 'x' | 'chevron-right' | 'chevron-left' | 'chevron-down' | 'arrow-right' | 'arrow-left' | 'plus' | 'minus' | 'clock' | 'timer' | 'flame' | 'zap' | 'info' | 'alert-triangle' | 'user' | 'mail' | 'lock' | 'eye' | 'eye-off' | 'home' | 'calendar' | 'chart' | 'trending-up' | 'trending-down' | 'message-circle' | 'send' | 'sparkles' | 'leaf' | 'droplet' | 'moon' | 'bell' | 'camera' | 'image' | 'target' | 'trophy' | 'heart' | 'star' | 'play' | 'utensils' | 'chef-hat' | 'repeat' | 'check-circle' | 'circle' | 'settings' | 'more-horizontal' | 'scale' | 'dumbbell' | 'apple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|soft|primary|solid)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'soft' | 'primary' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|leftIcon|rightSlot|suffix|error|hint|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, variant, leftIcon, rightSlot, suffix, error, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|filled)$/]",
        "message": "<Input> variant must be one of 'outline' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconTone|title|subtitle|value|trailing|chevron|divider|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: icon, iconTone, title, subtitle, value, trailing, chevron, divider."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute[name.name='iconTone'] > Literal[value!=/^(?:primary|accent|info|warning|neutral)$/]",
        "message": "<ListRow> iconTone must be one of 'primary' | 'accent' | 'info' | 'warning' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|onDark|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|wordmark|mark)$/]",
        "message": "<Logo> variant must be one of 'lockup' | 'wordmark' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MealTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|icon|key|ref|className|style|children)$/]",
        "message": "<MealTag> doesn't accept that prop. Declared props: label, variant, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='MealTag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|success|neutral)$/]",
        "message": "<MealTag> variant must be one of 'primary' | 'accent' | 'success' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaPlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|tone|icon|label|width|height|radius|key|ref|className|style|children)$/]",
        "message": "<MediaPlaceholder> doesn't accept that prop. Declared props: src, tone, icon, label, width, height, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaPlaceholder'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:food|exercise|neutral)$/]",
        "message": "<MediaPlaceholder> tone must be one of 'food' | 'exercise' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|thickness|color|trackColor|label|valueText|children|key|ref|className|style|children)$/]",
        "message": "<MetricRing> doesn't accept that prop. Declared props: value, max, size, thickness, color, trackColor, label, valueText, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|color|height|label|showValue|valueText|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, color, height, label, showValue, valueText."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<SegmentOption> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|unit|onChange|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: value, min, max, step, unit, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:selectable|selected|leftIcon|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: selectable, selected, leftIcon."
      }
    ]
